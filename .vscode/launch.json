{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Active File (C++)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/${fileBasenameNoExtension}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "Build Active Target",
            "miDebuggerArgs": "-iex \"set debuginfod enabled off\" -iex \"set debuginfod urls \"",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Wipe debuginfod URLs to bypass extension bug",
                    "text": "set debuginfod urls ",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
