{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B", "build",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
            ],
            "group": "build",
            "problemMatcher": [],
            "detail": "生成 CMake 构建文件"
        },
        {
            "label": "Build Active Target",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build",
                "--target", "${fileBasenameNoExtension}",
                "--", "-j"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": ["CMake Configure"],
            "problemMatcher": ["$gcc"],
            "detail": "使用 CMake 构建当前文件对应的目标"
        },
        {
            "label": "Build All",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build",
                "--", "-j"
            ],
            "group": "build",
            "dependsOn": ["CMake Configure"],
            "problemMatcher": ["$gcc"],
            "detail": "使用 CMake 构建所有目标"
        }
    ]
}
